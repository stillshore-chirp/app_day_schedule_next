{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework"]
  },
  "include": [
    "vite.config.ts",
    "vitest*.config.ts",
    "wdio*.conf.ts",
    "scripts/**/*.ts",
    "tests/e2e/**/*.ts"
  ]
}
