{
  "productName": "Day Schedule Next E2E",
  "identifier": "com.stillshorechirp.dayschedulenext.e2e",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "main",
        "compact",
        "analog-clock",
        {
          "identifier": "e2e",
          "description": "Test-only WebdriverIO permissions, activated only by this isolated E2E configuration.",
          "windows": ["main", "compact", "analog-clock"],
          "permissions": ["wdio:default", "wdio-webdriver:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
